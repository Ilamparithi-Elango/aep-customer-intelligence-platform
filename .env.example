# AEP Customer Intelligence Platform – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=aep-customer-intelligence-platform

# AWS credentials (alternatively, configure via `aws configure` or IAM role)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=6
AGENT_VERBOSE=false

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json          # json | text
SERVICE_NAME=aep-customer-intelligence-platform

# ── Airflow ───────────────────────────────────────────────────────────────────
# AEP_PROJECT_ROOT=/path/to/aep-customer-intelligence-platform
# AEP_PYTHON_BIN=python
# AEP_SPARK_SUBMIT=spark-submit
